<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="~/" class="logo">
                <img src="~/images/logobarca.png" alt="FC Barcelona Logo" class="logo-img" />
                FC BARCELONA
            </a>
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">Home</a></li>
                <li><a asp-controller="Home" asp-action="Squad" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Squad" ? "active" : "")">Squad</a></li>
                <li><a asp-controller="Home" asp-action="Trophies" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Trophies" ? "active" : "")">Trophies</a></li>
                <li><a asp-controller="Home" asp-action="Favourites" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Favourites" ? "active" : "")">Favourites</a></li>
            </ul>
            <div class="user">
                <a href="#" class="user-name">S. Bolohan</a>
                <span class="user-avatar"></span>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
