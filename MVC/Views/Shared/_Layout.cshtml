<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MVC</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="preload" href="~/fonts/Anton-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/BarlowCondensed-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/BarlowCondensed-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="~/fonts/BarlowCondensed-SemiBold.woff2" as="font" type="font/woff2" crossorigin />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <nav class="nav">
            <a href="~/" class="logo">
                <img src="~/images/logobarca.png" alt="FC Barcelona Logo" class="logo-img" />
                FC BARCELONA
            </a>
            <ul class="nav-links">
                <li><a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">Home</a></li>
                <li><a asp-controller="Home" asp-action="Squad" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Squad" ? "active" : "")">Squad</a></li>
                <li><a asp-controller="Home" asp-action="Trophies" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Trophies" ? "active" : "")">Trophies</a></li>
                <li><a asp-controller="Home" asp-action="Favourites" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Favourites" ? "active" : "")">Favourites</a></li>
            </ul>
            <div class="user">
                <a asp-controller="Home" asp-action="Login" class="user-name">S. Bolohan</a>
                <span class="user-avatar"></span>
            </div>
        </nav>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer class="footer">
        <p>&copy; @DateTime.Now.Year FC Barcelona.</p>
        <div class="footer-links">
            <a href="https://www.fcbarcelona.com" target="_blank" rel="noopener">fcbarcelona.com</a>
            <span class="footer-divider">|</span>
            <span>Made by Sergiu Bolohan</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
