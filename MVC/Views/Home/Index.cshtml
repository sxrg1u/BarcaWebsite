@{
    ViewData["Title"] = "Home Page";
}
<main>
    <section class="hero">
        <div class="hero-info">
            <p class="season">Season 2025/26</p>
            <h1 class="club-name">FC BARCELONA</h1>
        </div>

        <div class="hero-stats">
            <div class="stat">
                <p class="stat-number">26</p>
                <p class="stat-text">Players in squad</p>
            </div>

            <div class="stat">
                <p class="stat-number">78</p>
                <p class="stat-text">Trophies won</p>
            </div>
        </div>
    </section>

    <section class="trophies">
        <h2>Recently Won</h2>
        <p>The three most recent trophies.</p>

        <div class="trophy-grid">
            <a class="trophy-card" asp-controller="Home" asp-action="Trophies">
                <h3>LaLiga <span>2024/25</span></h3>
                <img src="~/images/Hauptseite/laliga.png" alt="LaLiga 2024/25 Pokal" />
            </a>

            <a class="trophy-card" asp-controller="Home" asp-action="Trophies">
                <h3>Copa del Rey <span>2024/25</span></h3>
                <img src="~/images/Hauptseite/COPADELREY.png" alt="Copa del Rey 2024/25 Pokal" />
            </a>

            <a class="trophy-card" asp-controller="Home" asp-action="Trophies">
                <h3>Supercopa de Espana <span>2025</span></h3>
                <img src="~/images/Hauptseite/supercopaDeEspana.png" alt="Supercopa de España 2025 Pokal" />
            </a>
        </div>
    </section>
</main>