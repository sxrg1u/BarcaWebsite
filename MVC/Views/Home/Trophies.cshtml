@{
    ViewData["Title"] = "Trophies";
}
<main>
    <section class="trophies-page">
        <h1>Trophies</h1>

        <div class="trophy-stat-grid">
        </div>

        <h2>All Trophies <span class="trophies-since">since 2010</span></h2>

        <div class="trophies-table-wrap">
            <table class="trophies-table">
                <thead>
                    <tr>
                        <th>Year</th>
                        <th>Competition</th>
                        <th>Coach</th>
                        <th>Category</th>
                    </tr>
                </thead>
                <tbody>
                    
                </tbody>
            </table>
        </div>
    </section>

    <div class="trophies-messi-row">
        <img src="~/images/Players/TrophiSeite/messiChampionsleague.png"
             class="trophies-messi"
             alt="Lionel Messi mit dem Champions-League-Pokal"
             title="Messi" />
    </div>
</main>
