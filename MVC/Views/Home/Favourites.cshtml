@{
    ViewData["Title"] = "Favourites";
}
@model List<MVC.Models.Player>
<main>
    <section class="page-hero">
        <div class="page-hero-inner">
            <div class="page-hero-text">
                <p class="season">My Squad</p>
                <h1>Favourites</h1>
                <p class="page-hero-sub">
                    <strong class="favourites-count">@Model.Count</strong>
                    @(Model.Count == 1 ? "player" : "players")
                </p>
            </div>

            <img src="~/images/Players/LamineBall.png" class="favourites-hero-img" alt="" aria-hidden="true" />
        </div>
    </section>

    <section class="favourites">
        @if (Model.Count == 0)
        {
            <!-- Leerer Zustand: noch keine Favoriten -->
            <div class="favourites-empty">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 3.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L12 16.9l-5.25 2.7 1-5.8L3.5 9.7l5.9-.9L12 3.5Z" />
                </svg>
                <h2>No favourites yet</h2>
                <p>Tap the star next to a player in the squad to add him here.</p>
                <a asp-controller="Home" asp-action="Squad" class="favourites-more-btn">Go to Squad &rarr;</a>
            </div>
        }
        else
        {
            <div class="favourites-grid">
                @foreach (var p in Model)
                {
                    <article class="favourites-card">
                        <div class="favourites-card-photo">
                            <img src="@p.ImagePath" alt="@p.Name" loading="lazy" />
                            <span class="favourites-card-number">@p.ShirtNumber</span>

                            <form method="post" asp-action="ToggleFavourite">
                                <input type="hidden" name="playerId" value="@p.Id" />
                                <input type="hidden" name="returnTo" value="Favourites" />
                                <button type="submit" class="favourites-remove" title="Remove from favourites" aria-label="Remove @p.Name from favourites">&#9733;</button>
                            </form>
                        </div>

                        <div class="favourites-card-body">
                            <span class="favourites-card-pos">@p.Position</span>
                            <h3>@p.Name</h3>
                            <p class="favourites-card-meta">@p.Country &middot; @p.Age years</p>
                        </div>
                    </article>
                }

                <a asp-controller="Home" asp-action="Squad" class="favourites-more">
                    <span class="favourites-more-plus" aria-hidden="true">+</span>
                    <h3>Add more players</h3>
                    <span class="favourites-more-btn">Go to Squad &rarr;</span>
                </a>
            </div>
        }
    </section>
</main>
