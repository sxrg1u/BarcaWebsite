@{
    ViewData["Title"] = "Squad";
}
@model List<MVC.Models.Player>
<main>
    <section class="squad">
        <h1>Squad</h1>
        <p>@Model.Count players. Select a row to open the player detail view or fav a player.</p>

        <div class="squad-search">
            <img src="~/images/logobarca.png" alt="FC Barcelona Logo" class="squad-search-logo" />
            <input type="text" class="squad-search-input" placeholder="Search player by name ..." />
        </div>

        <div class="squad-table-wrap">
            <table class="squad-table">
                <thead>
                    <tr>
                        <th class="squad-col-photo"></th>
                        <th>No.</th>
                        <th>Player</th>
                        <th>Country</th>
                        <th>Position</th>
                        <th>Age</th>
                        <th>Fav</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr class="squad-row">
                            <td><img src="@p.ImagePath" alt="@p.Name" class="squad-avatar" /></td>
                            <td>@p.ShirtNumber</td>
                            <td class="squad-player-name">@p.Name</td>
                            <td>@p.Country</td>
                            <td>@p.Position</td>
                            <td>@p.Age</td>
                            <td><span class="squad-fav">&#9734;</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="squad-lineup">
        <img src="~/images/Players/SquadSeite/Lamine.png" class="p-yamal" alt="Yamal" title="Yamal" loading="lazy" />
        <img src="~/images/Players/SquadSeite/adeyemi.png" class="p-adeyemi" alt="Adeyemi" title="Adeyemi" loading="lazy" />
        <img src="~/images/Players/SquadSeite/cubarsi.png" class="p-cubarsi" alt="Cubars&#237;" title="Cubars&#237;" loading="lazy" />
        <img src="~/images/Players/SquadSeite/gorden.png" class="p-gordon" alt="Gordon" title="Gordon" loading="lazy" />
        <img src="~/images/Players/SquadSeite/pedri.png" class="p-pedri" alt="Pedri" title="Pedri" loading="lazy" />
        <img src="~/images/Players/SquadSeite/raphinia.png" class="p-raphinha" alt="Raphinha" title="Raphinha" loading="lazy" />
    </div>
</main>
